// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Expense {
  id          String   @id @default(uuid())
  amount      Int      // Stored in paise to avoid floating point issues
  category    String
  description String
  date        DateTime
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([category])
}

model IdempotencyKey {
  id            String   @id @default(uuid())
  key           String   @unique
  requestHash   String
  response      String   // JSON stringified response
  createdAt     DateTime @default(now())
  expiresAt     DateTime // Keys expire after 24 hours for cleanup

  @@index([key])
  @@index([createdAt])
}
